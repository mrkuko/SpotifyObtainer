# Copy this file to ".env" (same folder) and fill in your own values.
# Get them from https://developer.spotify.com/dashboard -> your app -> Settings.
# Never commit .env: it contains your client secret (.env is in .gitignore).

# "Client ID" from the app settings
SPOTIPY_CLIENT_ID=your_client_id_here

# "Client secret" from the app settings ("View client secret")
SPOTIPY_CLIENT_SECRET=your_client_secret_here

# Must be EXACTLY the same as one of the "Redirect URIs" in the app settings.
# Use 127.0.0.1, not "localhost" (Spotify no longer accepts localhost).
# Any free port works, as long as it matches the dashboard.
SPOTIPY_REDIRECT_URI=http://127.0.0.1:8888/callback
